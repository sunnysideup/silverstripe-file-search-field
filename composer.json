{
  "name": "sunnysideup/file-search-field",
  "description": "A form field that allows the user to pick any file (not image) from Assets, without having to browse to it in the hierarchy.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "form",
    "field",
    "form field",
    "search field",
    "file field",
    "file",
    "file search",
    "a cms for real people"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^6.0",
    "silverstripe/admin": "^3.0"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "Sunnysideup\\FileSearchField\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
